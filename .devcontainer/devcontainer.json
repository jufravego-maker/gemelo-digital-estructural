{
  "name": "Gemelo Digital Estructural (demo)",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "20" }
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postAttachCommand": {
    "api": "bash .devcontainer/run-api.sh",
    "dashboard": "bash .devcontainer/run-dashboard.sh"
  },
  "forwardPorts": [5173, 8000],
  "portsAttributes": {
    "5173": { "label": "Dashboard", "onAutoForward": "openBrowser" },
    "8000": { "label": "API (FastAPI)", "onAutoForward": "silent" }
  },
  "customizations": {
    "codespaces": { "openFiles": ["README.md"] },
    "vscode": { "extensions": ["ms-python.python"] }
  }
}
