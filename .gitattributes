# Contenedores de información pesados gestionados con Git LFS (ISO 19650 / CDE)
*.ifc  filter=lfs diff=lfs merge=lfs -text
*.ifczip filter=lfs diff=lfs merge=lfs -text
*.glb  filter=lfs diff=lfs merge=lfs -text
*.frag filter=lfs diff=lfs merge=lfs -text
*.shp  filter=lfs diff=lfs merge=lfs -text
*.shx  filter=lfs diff=lfs merge=lfs -text
*.dbf  filter=lfs diff=lfs merge=lfs -text
*.xlsx filter=lfs diff=lfs merge=lfs -text
*.pdf  filter=lfs diff=lfs merge=lfs -text

# Texto con finales de línea normalizados
*.py   text eol=lf
*.js   text eol=lf
*.jsx  text eol=lf
*.json text eol=lf
*.csv  text eol=lf
*.sql  text eol=lf
*.yml  text eol=lf
*.md   text eol=lf
*.sh   text eol=lf
